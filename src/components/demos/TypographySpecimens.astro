        <div class="seg" id="tt-mk" role="group" aria-label="Marqueur"><button aria-pressed="true" data-m="1">Avec filet</button><button aria-pressed="false" data-m="0">Sans filet</button></div>
      </div>
      <div class="out"><div class="t-h1 mark" id="tt-out">Rejoignez la réunion</div></div>
